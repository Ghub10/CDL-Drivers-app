# ─────────────────────────────────────────────────────────────────────────────
# CDL-Drivers — environment variables
# Copy this file to .env and fill in real values before running in production.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Phase 1) ────────────────────────────────────────────────────────
# Create a free project at https://supabase.com, then copy the Project URL
# and anon public key from Settings → API.
# When both are present the app uses Supabase Auth + Postgres instead of
# the localStorage demo.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Stripe (Phase 3) ──────────────────────────────────────────────────────────
# Publishable key from https://dashboard.stripe.com/apikeys
# Used client-side only (never the secret key).
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Price IDs from your Stripe Dashboard → Products
# Create two products: "Pro" ($49-79/mo) and "Team" ($149-199/mo)
VITE_STRIPE_PRICE_PRO=price_...
VITE_STRIPE_PRICE_TEAM=price_...

# Your deployed app URL (used to build Stripe success/cancel redirect URLs)
VITE_APP_URL=https://cdldrivers.app
